{
  "name": "max-first-90-days",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Бот в MAX: персональные сроки обязательных процедур для иностранных первокурсников",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "web:install": "npm ci --prefix web --ignore-scripts",
    "web:build": "npm run build --prefix web",
    "e2e": "npm run build --silent && npm run web:build --silent && playwright test",
    "web:dev": "npm run dev --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "demo": "node dist/demo.js",
    "demo:check": "node dist/demo.js --script",
    "subscribe": "node --env-file-if-exists=.env dist/subscribe.js",
    "commands": "node --env-file-if-exists=.env dist/commands.js",
    "funnel": "node --env-file-if-exists=.env dist/report.js",
    "office": "node --env-file-if-exists=.env dist/office.js",
    "qr": "node --env-file-if-exists=.env dist/qr.js",
    "university:check": "npm run build --silent && node dist/university-check.js",
    "sources:check": "npm run build --silent && node dist/sources-check.js",
    "demo:export": "npm run build && node scripts/export-demo.mjs",
    "demo:export:check": "npm run build && node scripts/export-demo.mjs --check",
    "db:import-sqlite": "npm run build --silent && node --env-file-if-exists=.env dist/db/import-sqlite.js",
    "lint": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.3.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "qrcode-generator": "2.0.4",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@maxhub/max-bot-api": "0.3.1",
    "pg": "8.23.0"
  }
}
