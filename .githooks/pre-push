#!/usr/bin/env bash
# Без взятой задачи не пушим. Push, который только удаляет ветки (уборка после merge:
# у каждого обновления локальный sha — нули), не проверяется.
# stdin: <local ref> <local sha> <remote ref> <remote sha> на строку.
refs="$(cat)"
if [ -n "$refs" ] && ! printf '%s\n' "$refs" | awk '$2 !~ /^0+$/ {found=1} END {exit !found}'; then
  exit 0
fi
script="$(git rev-parse --show-toplevel)/scripts/issues.sh"
if [ ! -f "$script" ]; then
  echo "[issues] в этой ветке нет scripts/issues.sh — влейте origin/main; работа без задачи запрещена" >&2
  exit 1
fi
bash "$script" check . || exit 1
