# Default: local, synthetic demonstration; no token needed.
APP_MODE=demo
TRANSPORT=console
BOT_PORT=3000
# For MAX: generate your own 32+ character secret; never commit .env.
WEBHOOK_SECRET=local-demo-only-not-for-deployment
MAX_BOT_TOKEN=
# PostgreSQL in Compose. For MAX: your own password of letters and digits (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=local-demo-only-not-for-deployment
# Only for npm start without Compose; Compose builds it from POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://bot:password@127.0.0.1:5432/bot
WEBHOOK_URL=
# APP_MODE=live refuses draft rules. Independent review is still required.
# University profile for users who open the bot without ?start=<id> (src/data/universities).
DEFAULT_UNIVERSITY=kfu
# Mini app. The built bundle is served by the same process on the same HTTPS origin as the webhook.
WEBAPP_DIR=./web/dist
# Local development only: origin of `npm --prefix web run dev`. Refused unless APP_MODE=demo + TRANSPORT=console.
WEBAPP_DEV_ORIGIN=
# Bot name for the "open the plan in the mini app" button (open_app). Leave empty until the app URL
# is registered with MAX: without it the button would open nothing.
WEBAPP_BOT=
# Public bot link: the plan forwarded from the mini app ends with it plus ?start=<university> (#129).
# Plain https://max.ru/<bot>, no parameters. Default: the hackathon bot.
BOT_LINK=https://max.ru/t149_hakaton_max_bot
# Actions per user per minute, chat and mini app together (#59). Over it the chat drops the update
# with one notice and the API answers 429.
RATE_LIMIT_PER_MINUTE=30
# Upper bound in ms for sending one queued message (1000-50000). A hung request is cut off and the
# message goes back to the outbox for a retry (#65).
SEND_TIMEOUT_MS=30000
# Deployed commit shown in /health. Set by the update command in docs/deploy.md
# (DEPLOYED_COMMIT=$(cat DEPLOYED_COMMIT) docker compose up ...); do not put it in .env.
# DEPLOYED_COMMIT=
