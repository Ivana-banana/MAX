# Default: local, synthetic demonstration; no token needed.
APP_MODE=demo
TRANSPORT=console
BOT_PORT=3000
# For MAX: generate your own 32+ character secret; never commit .env.
WEBHOOK_SECRET=local-demo-only-not-for-deployment
MAX_BOT_TOKEN=
# PostgreSQL in Compose. For MAX: your own password of letters and digits (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=local-demo-only-not-for-deployment
# Only for npm start without Compose; Compose builds it from POSTGRES_PASSWORD.
# DATABASE_URL=postgresql://bot:password@127.0.0.1:5432/bot
WEBHOOK_URL=
# APP_MODE=live refuses draft rules. Independent review is still required.
# University profile for users who open the bot without ?start=<id> (src/data/universities).
DEFAULT_UNIVERSITY=kfu
