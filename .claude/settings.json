{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git fetch:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git pull --ff-only:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree add:*)",
      "Bash(git worktree list:*)",
      "Bash(git merge origin/main)",
      "Bash(git push -u origin HEAD)",
      "Bash(git push origin HEAD:main)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)",
      "Bash(git commit -a:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(git branch -d:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-secrets.sh",
            "timeout": 30,
            "statusMessage": "Поиск секретов в файлах для коммита…"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-tests.sh",
            "timeout": 180,
            "statusMessage": "Тесты (если есть и что-то менялось)…"
          }
        ]
      }
    ]
  }
}
