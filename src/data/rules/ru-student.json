  "rules": [
    {
      "id": "medical-examination",
      "title": {
        "ru": "Медицинское освидетельствование",
        "en": "Medical examination"
      },
      "action": {
        "ru": "Пройти медосвидетельствование в уполномоченной медорганизации. Результаты в МВД передаёт сама клиника.",
        "en": "Undergo the medical examination at an authorised clinic. The clinic itself submits the results to the Ministry of Internal Affairs."
      },
      "term": {
        "event": "entry",
        "days": 30,
        "counting": "dayAfterEvent"
      },
      "repeat": {
        "months": 12,
        "graceDays": 30
      },
      "appliesIf": [
        {
          "field": "citizenship",
          "op": "notIn",
          "values": [
            "BY"
          ]
        },
        {
          "field": "purpose",
          "op": "eq",
          "value": "study"
        },
        {
          "field": "entryDate",
          "op": "onOrAfter",
          "value": "2026-09-01"
        }
      ],
      "documents": [
        {
          "id": "passport",
          "title": {
            "ru": "Паспорт",
            "en": "Passport"
          }
        },
        {
          "id": "passport-translation",
          "title": {
            "ru": "Нотариальный перевод паспорта",
            "en": "Notarised translation of the passport"
          }
        },
        {
          "id": "migration-card",
          "title": {
            "ru": "Миграционная карта",
            "en": "Migration card"
          }
        },
        {
          "id": "arrival-notification",
          "title": {
            "ru": "Уведомление о прибытии — уточните комплект в КФУ",
            "en": "Arrival notification — confirm the checklist with KFU"
          }
